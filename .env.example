# Majburiy: MongoDB Atlas ulanish satri (baza: saytim)
# Eslatma: MongoDB Atlas -> Network Access bo'limida 0.0.0.0/0 ruxsatini yoqing
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/saytim?retryWrites=true&w=majority

# Ixtiyoriy: MongoDB baza nomi (standart: saytim)
MONGODB_DB=saytim

# Ixtiyoriy: Telegram Bot bildirishnomalari uchun token (@BotFather)
TELEGRAM_TOKEN=

# Ixtiyoriy: Referal havola asosi (frontend uchun)
VITE_REF_LINK=https://t.me/yuyushop_bot
