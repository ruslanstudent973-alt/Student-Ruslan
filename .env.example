# ============================================
# YUYU Shop — Muhit o'zgaruvchilari (Vercel & Local)
# DIQQAT: Haqiqiy parol va tokenlarni bu faylga YOZMANG!
# Ularni faqat Vercel -> Settings -> Environment Variables bo'limiga kiriting.
# ============================================

# Majburiy: MongoDB Atlas ulanish satri
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Ixtiyoriy: MongoDB baza nomi (standart: saytim, masalan: YUYU)
MONGODB_DB=saytim

# Ixtiyoriy: Telegram Bot bildirishnomalari uchun token (@BotFather)
TELEGRAM_TOKEN=

# Ixtiyoriy: Referal havola asosi (frontend uchun)
VITE_REF_LINK=https://student-ruslan.vercel.app/
