# MongoDB Atlas Connection String (database: saytim)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/saytim?retryWrites=true&w=majority
MONGODB_DB=saytim

# Cloudflare R2 Object Storage (S3-Compatible)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=yuyushop
# Optional: Public R2.dev or custom CDN domain (e.g. https://media.yuyushop.uz)
# If omitted, files are served via /api/r2/media/<key>
R2_PUBLIC_URL=

# Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_TOKEN=
ADMIN_CHAT_ID=

# Gemini API Key (Settings > Secrets or Vercel Environment Variables)
GEMINI_API_KEY=

# Public site domain for sitemap.xml and robots.txt (optional on Vercel)
APP_URL=https://yuyu.uz

# Web Push Notifications (VAPID keys: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yuyu.uz

# Optional secret for Vercel Cron (/api/auction/notify-ending)
CRON_SECRET=

# Google Sign-In (Google Identity Services OAuth 2.0 Web Client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=